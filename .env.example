# Variables de entorno de Nara.
#
# Copia este archivo a ".env.local" para tu entorno local:
#   cp .env.example .env.local
#
# Ninguna de estas variables se usa todavía. Están listadas como referencia
# para las etapas futuras. Nunca escribas aquí secretos reales ni subas
# ".env.local" a GitHub (ya está ignorado en .gitignore).

# Base de datos (etapa de usuarios y datos) — pendiente
# DATABASE_URL=

# Secreto para firmar sesiones (etapa de inicio de sesión) — pendiente
# AUTH_SECRET=

# Proveedor de inteligencia artificial (etapa del asistente) — pendiente
# AI_API_KEY=

# Correo electrónico para notificaciones (etapa de notificaciones) — pendiente
# EMAIL_SERVER_URL=
# EMAIL_FROM=
